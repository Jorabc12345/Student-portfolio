{
  "name": "buksu-com-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write src index.html vite.config.ts tailwind.config.ts postcss.config.cjs eslint.config.js package.json",
