# Supabase browser configuration.
# Use the project URL and publishable/anon key from the Supabase project settings.
# Never place a service-role key, database password, or other secret in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_PORTFOLIO_OWNER_EMAIL=owner@buksu.edu.ph
